# ============================================================
# 医学知识库系统 —— Git 忽略清单
# 只忽略运行产物/缓存/敏感配置，业务源码照常提交
# ============================================================

# ---- Python 运行缓存 ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- 本地上传临时文件（正式附件都在 MinIO，本地目录不入库）----
data/uploads/

# ---- 运行日志与进程号 ----
logs/*.log
logs/*.log.*
*.pid

# ---- 环境变量 / 敏感配置（含数据库密码、密钥，切勿提交）----
.env
.env.*
*.secret

# ---- Python 虚拟环境 ----
venv/
.venv/
env/
ENV/

# ---- macOS 系统文件 ----
.DS_Store
.AppleDouble
._*

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*.swo

# ---- Trae 工具目录（规格/会话等本地文件）----
.trae/
